<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Dock.Host</RootNamespace>
    <AssemblyName>Dock</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Dock.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Version>1.1.0</Version>
    <WebRoot>$(MSBuildProjectDirectory)\..\..\web</WebRoot>
    <WebDist>$(WebRoot)\dist</WebDist>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>
  <ItemGroup>
    <None Include="hooks\dock-agent-state.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\Dock.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Dock.Core\Dock.Core.csproj" />
  </ItemGroup>
  <Target Name="BuildWeb" BeforeTargets="BeforeBuild" Condition="!Exists('$(WebDist)\index.html') Or '$(Configuration)' == 'Release'">
    <Exec Command="pnpm install --frozen-lockfile" WorkingDirectory="$(WebRoot)" />
    <Exec Command="pnpm build" WorkingDirectory="$(WebRoot)" />
  </Target>
  <Target Name="CopyWebToOutput" AfterTargets="Build" DependsOnTargets="BuildWeb">
    <ItemGroup>
      <WebFiles Include="$(WebDist)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(WebFiles)" DestinationFiles="@(WebFiles->'$(OutDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyWebToPublish" AfterTargets="Publish">
    <ItemGroup>
      <WebPublishFiles Include="$(WebDist)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(WebPublishFiles)" DestinationFiles="@(WebPublishFiles->'$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
