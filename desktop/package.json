{
  "name": "tily",
  "productName": "Tily",
  "version": "3.1.0",
  "description": "Terminal macOS organisé en workspaces, onglets et panes",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "pnpm build && electron .",
    "dist": "pnpm build && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2"
  }
}
